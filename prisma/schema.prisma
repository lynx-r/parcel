generator client {
  provider      = "prisma-client-js"
  // output        = "./generated/client"
  // format        = "esm" // Явно указываем ESM (опционально, в новых версиях не требуется)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // Задай переменную окружения в .env
}

model User {
  id          Int    @id @default(autoincrement())
  first_name  String
  second_name String

  // Связи
  orders       Order[]
  stage_orders StageOrder[]
  trips        Trip[]
  action_logs  FsmActionLog[]
  error_logs   FsmErrorLog[]

  @@map("users")
}

model FsmState {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(50)
  label String? @db.VarChar(100)

  transitions_from FsmTransition[] @relation("FromState")
  transitions_to   FsmTransition[] @relation("ToState")

  @@map("fsm_states")
}

model FsmAction {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(50)
  label String? @db.VarChar(100)

  transitions FsmTransition[]

  @@map("fsm_actions")
}

model FsmTransition {
  id            Int @id @default(autoincrement())
  from_state_id Int
  action_id     Int
  to_state_id   Int

  from_state FsmState  @relation("FromState", fields: [from_state_id], references: [id])
  to_state   FsmState  @relation("ToState", fields: [to_state_id], references: [id])
  action     FsmAction @relation(fields: [action_id], references: [id])

  @@map("fsm_transitions")
}

model FsmActionLog {
  id          Int       @id @default(autoincrement())
  entity_type String?   @db.VarChar(50)
  entity_id   Int
  action_name String?   @db.VarChar(100)
  from_state  String?   @db.VarChar(50)
  to_state    String?   @db.VarChar(50)
  user_id     Int
  created_at  DateTime?
  User        User?     @relation(fields: [user_id], references: [id])

  @@map("fsm_action_logs")
}

model FsmErrorLog {
  id            Int       @id @default(autoincrement())
  error_time    DateTime?
  error_message String    @db.Text
  entity_type   String?   @db.VarChar(50)
  entity_id     Int
  action_name   String?   @db.VarChar(100)
  user_id       Int
  User          User?     @relation(fields: [user_id], references: [id])

  @@map("fsm_errors_log")
}

model Parcel {
  id       Int    @id @default(autoincrement())
  location String @db.VarChar(1000)
  value    String @db.VarChar(255)

  order Order?
}

model Logistic {
  id Int @id @default(autoincrement())

  type String

  cell_id   Int?
  cell      Parcel? @relation(fields: [cell_id], references: [id])
  cell_size String? @default("S") @db.VarChar(10)

  address String?

  shipment Shipment?
}

model Shipment {
  id Int @id @default(autoincrement())

  delivery_id Int      @unique
  delivery    Logistic @relation("ShipmentDelivery", fields: [delivery_id], references: [id])

  pickup_id Int      @unique
  pickup    Logistic @relation("ShipmentPickup", fields: [delivery_id], references: [id])

  order Order?
}

model Order {
  id Int @id @default(autoincrement())

  status      String? @db.VarChar(50)
  description String? @db.VarChar(255)

  sender_id Int?
  sender    User? @relation("Sender", fields: [sender_id], references: [id])

  recipient_id Int?
  recipient    User? @relation("Recipient", fields: [recipient_id], references: [id])

  shipment_id Int?      @unique
  shipment    Shipment? @relation(fields: [shipment_id], references: [id])

  @@map("orders")
}

model StageOrder {
  id          Int     @id @default(autoincrement())
  status      String? @db.VarChar(50)
  description String? @db.VarChar(255)
  User        User?   @relation(fields: [user_id], references: [id])
  user_id     Int?

  @@map("stage_orders")
}

model Trip {
  id          Int     @id @default(autoincrement())
  status      String? @db.VarChar(50)
  description String? @db.VarChar(255)
  User        User?   @relation(fields: [user_id], references: [id])
  user_id     Int?

  @@map("trips")
}
