generator client {
  provider      = "prisma-client-js"
  // output        = "./generated/client"
  // format        = "esm" // Явно указываем ESM (опционально, в новых версиях не требуется)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // Задай переменную окружения в .env
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  phone String

  // Связи
  sender_orders    Order[] @relation("Sender")
  recipient_orders Order[] @relation("Recipient")

  action_logs FsmActionLog[]
  error_logs  FsmErrorLog[]

  @@map("users")
}

model FsmState {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(50)
  label String? @db.VarChar(100)

  transitions_from FsmTransition[] @relation("FromState")
  transitions_to   FsmTransition[] @relation("ToState")

  @@map("fsm_states")
}

model FsmAction {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(50)
  label String? @db.VarChar(100)

  transitions FsmTransition[]

  @@map("fsm_actions")
}

model FsmTransition {
  id            Int @id @default(autoincrement())
  from_state_id Int
  action_id     Int
  to_state_id   Int

  from_state FsmState  @relation("FromState", fields: [from_state_id], references: [id])
  to_state   FsmState  @relation("ToState", fields: [to_state_id], references: [id])
  action     FsmAction @relation(fields: [action_id], references: [id])

  @@map("fsm_transitions")
}

model FsmActionLog {
  id          Int       @id @default(autoincrement())
  entity_type String?   @db.VarChar(50)
  entity_id   Int
  action_name String?   @db.VarChar(100)
  from_state  String?   @db.VarChar(50)
  to_state    String?   @db.VarChar(50)
  created_at  DateTime?

  user_id Int?
  user    User? @relation(fields: [user_id], references: [id])

  @@map("fsm_action_logs")
}

model FsmErrorLog {
  id            Int       @id @default(autoincrement())
  error_time    DateTime?
  error_message String    @db.Text
  entity_type   String?   @db.VarChar(50)
  entity_id     Int
  action_name   String?   @db.VarChar(100)

  user_id Int?
  user    User? @relation(fields: [user_id], references: [id])

  @@map("fsm_errors_log")
}

model Parcel {
  id       Int    @id @default(autoincrement())
  location String @db.VarChar(1000)
  value    String @db.VarChar(255)

  logistic Logistic[]

  @@map("parcels")
}

model Logistic {
  id Int @id @default(autoincrement())

  type String

  cell_id   Int?
  cell      Parcel? @relation(fields: [cell_id], references: [id])
  cell_size String? @default("S") @db.VarChar(10)

  address String?

  // Логистика может быть пунктом доставки для ОДНОГО отправления
  delivery_shipment Shipment? @relation("ShipmentDelivery")

  // Логистика может быть пунктом забора для ОДНОГО отправления
  pickup_shipment Shipment? @relation("ShipmentPickup")

  @@map("logistics")
}

model Shipment {
  id Int @id @default(autoincrement())

  type String

  // Связь с логистикой, которая является пунктом доставки
  delivery_id Int      @unique
  delivery    Logistic @relation("ShipmentDelivery", fields: [delivery_id], references: [id], map: "ShipmentDelivery_fkey")

  // Связь с логистикой, которая является пунктом забора
  pickup_id Int      @unique
  pickup    Logistic @relation("ShipmentPickup", fields: [pickup_id], references: [id], map: "ShipmentPickup_fkey")

  order Order?

  @@map("shipments")
}

model Order {
  id Int @id @default(autoincrement())

  status      String? @db.VarChar(50)
  description String? @db.VarChar(255)

  sender_id Int?
  sender    User? @relation("Sender", fields: [sender_id], references: [id])

  recipient_id Int?
  recipient    User? @relation("Recipient", fields: [recipient_id], references: [id])

  shipment_id Int?      @unique
  shipment    Shipment? @relation(fields: [shipment_id], references: [id])

  stage_order StageOrder?

  @@map("orders")
}

model StageOrder {
  id          Int     @id @default(autoincrement())
  status      String? @db.VarChar(50)
  description String? @db.VarChar(255)

  order_id Int?   @unique
  order    Order? @relation(fields: [order_id], references: [id])

  @@map("stage_orders")
}

model Trip {
  id          Int     @id @default(autoincrement())
  status      String? @db.VarChar(50)
  description String? @db.VarChar(255)

  @@map("trips")
}
